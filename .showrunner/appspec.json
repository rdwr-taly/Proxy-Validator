{
  "capabilities": {
    "can_stop": true
  },
  "category": "Security Tools",
  "deployment": {
    "container_command_template": [
      "--validate"
    ],
    "default_env_vars": [
      {
        "default_value": true,
        "label": "Distribute File",
        "name": "DISTRIBUTE_FILE",
        "tooltip": "If true, the validated /app/output/HTTP.txt is pushed to remote servers.",
        "type": "boolean"
      },
      {
        "default_value": "/home/shared/proxies/HTTP.txt",
        "label": "Destination Path (Remote)",
        "name": "REMOTE_DEST_PATH",
        "required": true,
        "tooltip": "Remote absolute path where HTTP.txt will be copied (e.g., /var/www/proxies/HTTP.txt).",
        "type": "string"
      },
      {
        "default_value": "[]",
        "item_name_label": "Host",
        "label": "Server Configurations",
        "name": "DISTRIBUTION_CONFIG_JSON",
        "sub_fields_ref": [
          "host",
          "user",
          "password"
        ],
        "tooltip": "Add one entry per server. Only username/password auth is exposed.",
        "type": "string",
        "ui_type": "field_group_list"
      },
      {
        "label": "Host",
        "name": "host",
        "type": "string"
      },
      {
        "label": "User",
        "name": "user",
        "type": "string"
      },
      {
        "label": "Password",
        "name": "password",
        "tooltip": "Password used with sshpass for rsync.",
        "type": "string",
        "ui_type": "password"
      }
    ]
  },
  "deploymentContext": "job",
  "description": "Validates generated proxy lists and (optionally) distributes the final HTTP.txt to remote servers using username/password.",
  "displayName": "Proxy Validator Job",
  "icon": "fas fa-server",
  "id": "proxy-validator-job",
  "schema_version": 7,
  "image_id_ref": "razor29/proxy-validator",
  "lifecycleOptions": [
    {
      "description": "Run validation once and complete when the job exits successfully.",
      "isDefault": true,
      "label": "One-Time Job",
      "lifecycle": "one_time"
    },
    {
      "description": "Run validation repeatedly on an interval. Each run exits and is scheduled again for the next interval.",
      "label": "Recurring",
      "lifecycle": "recurrent",
      "scheduling_fields": {
        "interval_unit": "minutes",
        "interval_value": 20,
        "max_concurrent_runs": 1,
        "overlap_policy": "skip",
        "start_time_utc": {
          "label": "Start Time (UTC)",
          "required": true
        },
        "type": "interval"
      }
    }
  ],
  "subCategory": "Proxy Tools",
  "taskLifecycle": "one_time",
  "sdk": {
    "contract_version": 1,
    "capabilities": [
      "report_pull_file",
      "measures"
    ],
    "reporting": {
      "mode": "file",
      "path": "/report/report.json",
      "sealed_field": "status",
      "sealed_value": "final",
      "poll_interval_sec": 30,
      "expected_cadence_seconds": 1800,
      "grace_seconds": 600
    },
    "measures": [
      {
        "key": "proxies_tested",
        "label": "Proxies tested",
        "type": "count",
        "unit": "proxies",
        "source": {
          "kind": "report_json",
          "path": "proxies_tested"
        },
        "success_checkable": false
      },
      {
        "key": "proxies_validated",
        "label": "Proxies validated",
        "type": "count",
        "unit": "proxies",
        "higher_is_better": true,
        "source": {
          "kind": "report_json",
          "path": "proxies_validated"
        },
        "success_checkable": true
      },
      {
        "key": "proxies_failed",
        "label": "Proxies failed",
        "type": "count",
        "unit": "proxies",
        "source": {
          "kind": "report_json",
          "path": "proxies_failed"
        },
        "success_checkable": false
      },
      {
        "key": "validation_success_ratio",
        "label": "Validation success ratio",
        "type": "ratio",
        "unit": "fraction",
        "higher_is_better": true,
        "source": {
          "kind": "report_json",
          "path": "validation_success_ratio"
        },
        "success_checkable": true
      },
      {
        "key": "job_success",
        "label": "Job succeeded",
        "type": "enum",
        "options": [
          "true",
          "false"
        ],
        "source": {
          "kind": "report_json",
          "path": "job_success"
        },
        "success_checkable": true
      },
      {
        "key": "job_duration_seconds",
        "label": "Job duration",
        "type": "number",
        "unit": "s",
        "source": {
          "kind": "report_json",
          "path": "job_duration_seconds"
        },
        "success_checkable": false
      },
      {
        "key": "distribution_success",
        "label": "Distribution succeeded",
        "type": "enum",
        "options": [
          "true",
          "false",
          "n/a"
        ],
        "source": {
          "kind": "report_json",
          "path": "distribution_success"
        },
        "success_checkable": true
      }
    ],
    "alert_profiles": [
      {
        "id": "continuous",
        "label": "Continuous demo",
        "rules": [
          {
            "id": "pv1",
            "label": "validated at least 1 proxy",
            "kind": "require",
            "source": "report",
            "field": "proxies_validated",
            "op": ">=",
            "value": 1,
            "severity": "error",
            "enabled": true
          },
          {
            "id": "pv2",
            "label": "job succeeded",
            "kind": "require",
            "source": "report",
            "field": "job_success",
            "op": "==",
            "value": "true",
            "severity": "error",
            "enabled": true
          },
          {
            "id": "pv3",
            "label": "file distribution did not fail",
            "kind": "alert_when",
            "source": "report",
            "field": "distribution_success",
            "op": "==",
            "value": "false",
            "severity": "error",
            "enabled": true
          },
          {
            "id": "pv4",
            "label": "job stopped running",
            "kind": "alert_when",
            "source": "liveness",
            "severity": "critical",
            "enabled": true
          }
        ]
      },
      {
        "id": "oneshot",
        "label": "One-shot / test",
        "rules": [
          {
            "id": "pv1",
            "label": "validated at least 1 proxy",
            "kind": "require",
            "source": "report",
            "field": "proxies_validated",
            "op": ">=",
            "value": 1,
            "severity": "error",
            "enabled": true
          },
          {
            "id": "pv2",
            "label": "job succeeded",
            "kind": "require",
            "source": "report",
            "field": "job_success",
            "op": "==",
            "value": "true",
            "severity": "error",
            "enabled": true
          },
          {
            "id": "pv3",
            "label": "file distribution did not fail",
            "kind": "alert_when",
            "source": "report",
            "field": "distribution_success",
            "op": "==",
            "value": "false",
            "severity": "error",
            "enabled": true
          }
        ]
      }
    ],
    "default_alert_profile": "continuous",
    "default_playbook": {
      "steps": [
        {
          "id": "validation_completed",
          "name": "Validation job completed successfully",
          "check": {
            "source": "report",
            "field": "job_success",
            "op": "==",
            "value": "true"
          }
        },
        {
          "id": "proxies_found",
          "name": "At least one proxy validated",
          "check": {
            "source": "report",
            "field": "proxies_validated",
            "op": ">=",
            "value": 1
          }
        }
      ]
    }
  },
  "ui": {
    "deployment_form_sections": [
      {
        "fields": [
          "DISTRIBUTE_FILE",
          "REMOTE_DEST_PATH"
        ],
        "title": "General Settings"
      },
      {
        "fields": [
          "DISTRIBUTION_CONFIG_JSON"
        ],
        "title": "Servers"
      }
    ]
  }
}
